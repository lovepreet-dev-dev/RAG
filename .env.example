# ══════════════════════════════════════════════════════════════════════════════
# RAG Engine — Environment Configuration
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai, anthropic, gemini, ollama, lmstudio, openrouter
LLM_PROVIDER=openai

# OpenAI / Compatible
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LM Studio (local)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Embeddings ───────────────────────────────────────────────────────────────
# Options: bge-small, bge-large, minilm, nomic, openai
EMBEDDING_MODEL=bge-small

# ── Vector Store ─────────────────────────────────────────────────────────────
# Options: faiss, chroma, qdrant, pinecone
VECTOR_STORE=faiss

# FAISS
FAISS_INDEX_DIR=./data/faiss_index

# Chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=rag_documents

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=rag-documents
PINECONE_ENVIRONMENT=us-east1-gcp

# ── Chunking ─────────────────────────────────────────────────────────────────
# Options: recursive, semantic, sliding_window
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=128
SEMANTIC_CHUNK_THRESHOLD=0.75
MIN_CHUNK_LENGTH=10

# ── Retrieval ────────────────────────────────────────────────────────────────
SIMILARITY_TOP_K=10
MMR_TOP_K=10
HYBRID_TOP_K=10
SCORE_THRESHOLD=0.3
ENABLE_MMR=false
ENABLE_HYBRID_SEARCH=true
ENABLE_MULTI_QUERY=false
MULTI_QUERY_COUNT=3
MULTI_QUERY_THRESHOLD=0.4
ENABLE_HYDE=false
ENABLE_SYNONYM_EXPANSION=false
ENABLE_RERANKING=true
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-base
ENABLE_ANSWER_VALIDATION=true
MAX_CONTEXT_TOKENS=3000

# ── Ingestion ────────────────────────────────────────────────────────────────
ENABLE_OCR=false
OCR_LANGUAGE=eng
CSV_BATCH_SIZE=500
JSON_BATCH_SIZE=500

# ── Chat / Memory ────────────────────────────────────────────────────────────
ENABLE_MEMORY=true
MEMORY_WINDOW=10

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Authentication ───────────────────────────────────────────────────────────
ENABLE_AUTH=false
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/rag.db

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
